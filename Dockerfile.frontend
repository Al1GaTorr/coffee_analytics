# Build stage - optional if you have frontend build process
FROM node:24-alpine AS builder
WORKDIR /app
COPY frontend ./frontend
COPY package.json ./
# If you have a build script for frontend assets, uncomment:
# RUN npm install && npm run build:frontend

# Production stage - serve with nginx
FROM nginx:alpine
COPY --from=builder /app/frontend/static /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/nginx.conf

# Health check
HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD wget -qO- http://localhost:5173/ || exit 1

EXPOSE 5173
